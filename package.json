{
  "name": "score-editor",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "npm run lint:boundary && npm run lint:testnames && tsc --noEmit && vite build",
    "lint:boundary": "eslint --no-eslintrc -c .eslintrc.boundary.json \"src/engine/**/*.ts\" \"src/interactions/**/*.ts\" \"src/windows/**/*.ts\" \"src/menus/**/*.ts\" \"src/dev/**/*.ts\" \"src/utils/**/*.ts\" \"src/types/**/*.ts\"",
    "lint:testnames": "node scripts/check-test-names.mjs",
    "audit:tests": "node scripts/audit-tests.mjs",
    "lint": "eslint . --ext .ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "opentype.js": "^2.0.0",
    "svg2pdf.js": "^2.7.0",
    "uuid": "^13.0.0",
    "vexflow": "^5.0.0",
    "webaudiofont": "^3.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/opentype.js": "^1.3.10",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
